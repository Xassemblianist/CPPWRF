# cmake -DIN=<data/option_tiers.txt> -DOUT=<file> -P option_tiers.cmake
# Writes the verification tier table as a C++ raw string literal for src/io/option_tiers.cpp (the binaries carry the
# table; tools/wrf2cppwrf.py reads the same file). OUT is rewritten only when the table changes.
file(READ "${IN}" txt)
if(txt MATCHES "\\)tiers\"")
  message(FATAL_ERROR "${IN}: the text )tiers\" ends the raw string literal")
endif()
file(WRITE "${OUT}.tmp" "// generated by src/io/option_tiers.cmake from data/option_tiers.txt\nR\"tiers(${txt})tiers\"\n")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
