&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2026-10-12_00:00:00', '2026-10-12_00:00:00', '2026-10-12_00:00:00',
 end_date   = '2026-10-12_06:00:00', '2026-10-12_06:00:00', '2026-10-12_06:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
 debug_level = 0,
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   3,
 i_parent_start    =   1,  40,  50,
 j_parent_start    =   1,  30,  35,
 e_we              = 120, 121,  61,
 e_sn              =  90,  91,  61,
 geog_data_res     = 'lowres', 'lowres', 'lowres',
 dx = 15000,
 dy = 15000,
 map_proj = 'lambert',
 ref_lat   =  39.00,
 ref_lon   =  35.00,
 truelat1  =  30.0,
 truelat2  =  60.0,
 stand_lon =  35.0,
 geog_data_path = 'WPS_GEOG_LOW_RES',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
