# SPDX-License-Identifier: GPL-3.0-or-later
# CPPWRF, CPU build (OpenMP, FP64: bit-identical to WRF v4.8.0 real*8), on Debian 13, the system the proofs use
# (gcc 14.2, glibc 2.41). From the repository's top directory:
#   docker build -f packaging/docker/Dockerfile.cpu -t cppwrf:1.0.0-cpu .
#   docker run --rm -v "$PWD/case:/work" cppwrf:1.0.0-cpu cppwrf-wrf --threads 8       # a WRF run directory
# Pin the base image by digest for a reproducible image: --build-arg DEBIAN=debian:13.1-slim@sha256:...
ARG DEBIAN=debian:13.1-slim

FROM ${DEBIAN} AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++-14 cmake make libnetcdf-dev python3 python3-netcdf4 python3-numpy ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY . /src
# CPPWRF_NATIVE=OFF: no -march=native, the image runs on any x86-64 CPU
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++-14 \
      -DCPPWRF_ENABLE_CUDA=OFF -DCPPWRF_DOUBLE=ON -DCPPWRF_NATIVE=OFF \
    && cmake --build /build -j "$(nproc)" --target cppwrf cppwrf_real \
    && cmake --install /build --prefix /opt/cppwrf

FROM ${DEBIAN}
RUN apt-get update && apt-get install -y --no-install-recommends \
      libnetcdf22 libgomp1 python3 python3-netcdf4 python3-numpy \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/cppwrf /opt/cppwrf
ENV PATH=/opt/cppwrf/bin:$PATH PYTHONPATH=/opt/cppwrf/share/cppwrf/python
WORKDIR /work
CMD ["cppwrf-wrf"]
