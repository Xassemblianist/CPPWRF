# SPDX-License-Identifier: GPL-3.0-or-later
# Build from the repository root. The Debian 13 runtime supplies glibc 2.41.
# The base images are pinned by digest (multi-architecture index, 2026-11-25); update tag and digest together.
FROM debian:13.8-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates cmake curl file g++-14 gcc gfortran libnetcdf-dev libnetcdff-dev \
      m4 make patch perl python3 tcsh \
    && rm -rf /var/lib/apt/lists/*

COPY packaging/docker/build-wps.sh /tmp/build-wps.sh
RUN bash /tmp/build-wps.sh /opt/weather

ARG BUILD_JOBS=3
ARG VCS_REF
COPY . /src
RUN bash /src/packaging/docker/build-cppwrf.sh cpu-fp64 cpu-fp64 cpu-fp32

FROM debian:13.8-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/Xassemblianist/CPPWRF" \
      org.opencontainers.image.revision="${VCS_REF}"
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libgomp1 libnetcdff7 python3-matplotlib python3-netcdf4 python3-numpy util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/cppwrf /opt/cppwrf
COPY --from=build /opt/weather /opt/weather
COPY packaging/docker/NOTICE.md /opt/weather/notices/README.md
COPY --chmod=755 packaging/docker/cppwrf-quickstart /opt/cppwrf/bin/cppwrf-quickstart
ENV PATH=/opt/cppwrf/bin:$PATH \
    PYTHONPATH=/opt/cppwrf/share/cppwrf/python \
    WPS_DIR=/opt/weather/wps \
    WRF_DIR=/opt/weather/wrf \
    CPPWRF_QUICKSTART_MODE=cpu-fp64
WORKDIR /work
ENTRYPOINT ["cppwrf-quickstart"]
CMD ["cppwrf-wrf"]
